# Skopiuj do .env i uzupełnij. Plik .env NIGDY nie trafia do repo.

# Klucz Google AI Studio do warstwy wizyjnej (L3).
# Bez niego wszystko poza przyciskiem "Sprawdź zdjęciem" działa normalnie.
GEMINI_API_KEY=

# Ścieżka bazy SQLite. W kontenerze ustawiona w Dockerfile na /app/baza/atrybuty.db
# (nazwany wolumen). Nadpisuj tylko przy uruchomieniu poza Dockerem.
# ATRYBUTY_DB=/app/baza/atrybuty.db
